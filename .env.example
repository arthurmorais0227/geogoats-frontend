# URL do backend (sem barra no final)
API_URL=https://geogoats-backend.onrender.com

# chave PÚBLICA do backend (PUBLIC_API_KEY): só leitura (GET)
# é a usada na página Sobre nós para listar os participantes
API_KEY=lisboa

# chave ADMIN do backend (ADMIN_API_KEY): criar, editar e excluir (POST/PUT/DELETE)
# só preencha se o front for fazer edições, e use apenas no servidor
# (API Route em src/app/api/.../route.js), nunca com NEXT_PUBLIC_
ADMIN_API_KEY=
